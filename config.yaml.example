# home-dashboard (ab v0.1.0). Die geprueften Dienste kommen aus Prometheus
# (prometheus/conf/ziele/*.yml, Labels name/gruppe/link/icon/beschreibung) - hier stehen nur
# die Reihenfolge der Gruppen, Links ohne Pruefung und Beschreibungen der Diagramme.
gruppen: [Smarthome, Hermes, Finanzen, Monitoring, Server, Netzplan, Netz]

links:
  - {name: UniFi, url: 'https://unifi.ui.com', icon: ubiquiti.png, gruppe: Cloud,
     beschreibung: 'Netzwerkverwaltung (UDM)'}
  - {name: Tailscale, url: 'https://login.tailscale.com/admin/machines', icon: tailscale.png, gruppe: Cloud,
     beschreibung: 'VPN, Geraete'}
  - {name: Shelly Cloud, url: 'https://control.shelly.cloud', icon: power, gruppe: Cloud}
  - {name: Ecowitt, url: 'https://www.ecowitt.net/home/login', icon: ecowitt.png, gruppe: Cloud,
     beschreibung: 'Wetterstation'}
  - {name: Watermeter, url: 'http://192.168.4.15', icon: watermeter.png, gruppe: Smarthome,
     beschreibung: 'Wasserzaehler - von der NAS aus derzeit gesperrt (Firewall), daher ohne Pruefung'}

diagramme:
  network-map.png: 'Netzplan (Stand Februar, wird neu erstellt)'
